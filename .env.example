# API Configuration
# The base URL of the Laravel backend API (required)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# App Configuration
# Display name used in metadata and UI
NEXT_PUBLIC_APP_NAME=QAYEM Perfumes

# Canonical site URL (used for SEO, sitemap, and metadata)
# Must include the protocol (https:// in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Override the site URL for metadata (defaults to NEXT_PUBLIC_APP_URL)
# NEXT_PUBLIC_SITE_URL=https://qayem-perfumes.example
